          "roughness": "assets-src/polyhaven/textures/asphalt_02/textures/asphalt_02_rough_2k.jpg"
        },
        "sizeM": [
          3,
          3
        ],
        "sizeSource": "Poly Haven API dimensions",
        "sizes": [
          2048
        ]
      },
      {
        "id": "pavers",
        "source": "ambientCG PavingStones136",
        "credit": {
          "author": "ambientCG (Lennart Demes)",
          "url": "https://ambientcg.com/view?id=PavingStones136"
        },
        "maps": {
          "albedo": "assets-src/ambientcg/PavingStones136/PavingStones136_2K-JPG_Color.jpg",
          "normal": "assets-src/ambientcg/PavingStones136/PavingStones136_2K-JPG_NormalGL.jpg",
