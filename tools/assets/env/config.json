{
  "_comment": "Environment asset recipe. `node tools/assets/env/build.mjs [step...] [--only id,...]` regenerates public/assets/env/ from assets-src/ (see tools/assets/sources.json); steps: sky, textures, water, props, manifest, previews, check. `node tools/assets/env/check.mjs` validates the output.",
  "_fields": {
    "sky.hdri[]": "id, src (.hdr), mood, clouds (true: extract a cloud layer), cloudsEvidence (render the rejected attempt as a preview), cloudsVerdict (why no layer), stars (true: extract a star layer), credit {author, url}",
    "sky.flattenBelowDeg": "[start, end]: the 2K background fades to a per-row mean between these elevations",
    "textures.sets[]": "id, source, credit, maps {albedo, normal (OpenGL), arm | ao + roughness}, sizeM [u, v] metres per repeat, sizeSource, why, notes, calibrate ({meanLinear, neutral} or {meanLinearRGB}), sizes (overrides textures.sizes)",
    "procedural": "seed and per-texture size / tileM (metres per repeat) for the generated water textures",
    "props[]": "id; src (.gltf/.glb read directly; .fbx/.obj/.dae/.blend/.usd converted by blender/convert.py); credit {author, url}; texture (max texture size, 512 small / 1024 large); scale; rotateY (degrees, to turn the front to +Z); pivot ('base' default = base centre, 'origin-y' = keep source y = 0 (waterline), 'wall' = x centre, bottom, back plane); pivotFrom [node names to compute the pivot from]; variants {name: [source node names]} (one child node per variant, layout kept); parts {name: [source node names]} (separate movable children under lod0); lod0MaxTris (default 15000, simplified above it); lod1 (true/false to force; default: when lod0 > lod1Above = 10000); lod1Ratio (default 0.3); dropAttributes ['COLOR_0', ...]; materials {sourceName: {rename, alphaMode, baseColor, roughness, metallic, dropTextures [baseColor|metallicRoughness|normal], alphaFromBaseColorTexture}}; screen {material, planarUV}; notes"
  },
  "out": "public/assets/env",
  "build": "assets-src/_build/env",
  "previews": "assets-src/_previews/env",
  "sky": {
    "backgroundRes": 2048,
    "iblRes": 1024,
    "flattenBelowDeg": [
      -10,
      -20
    ],
    "hdri": [
      {
        "id": "qwantani_sunset_puresky",
        "src": "assets-src/polyhaven/hdri/qwantani_sunset_puresky_4k.hdr",
        "mood": "sunset",
        "clouds": false,
        "credit": {
          "author": "Greg Zaal (photography), Jarod Guest (processing)",
          "url": "https://polyhaven.com/a/qwantani_sunset_puresky"
        },
        "cloudsEvidence": true,
        "cloudsVerdict": "Not viable. Its only clouds are faint cirrus a few percent brighter than the sky and a horizon haze/stratus band the colour of the glow behind it. Three separations were tried (spatially smoothed clear sky, a clear-sky model in elevation x angle-to-sun, and the red/blue-ratio cloud cue that works for the day sky): each classifies the warm horizon glow itself as cloud and gives blotchy alpha (evidence: sky_qwantani_sunset_puresky_clouds_rejected.png). Use the HDRI itself as the visible sky, or the day cumulus layer relit in the shader."
      },
      {
        "id": "qwantani_dusk_2_puresky",
        "src": "assets-src/polyhaven/hdri/qwantani_dusk_2_puresky_4k.hdr",
        "mood": "dusk",
        "clouds": false,
        "credit": {
          "author": "Greg Zaal (photography), Jarod Guest (processing)",
          "url": "https://polyhaven.com/a/qwantani_dusk_2_puresky"
        },
        "cloudsEvidence": true,
        "cloudsVerdict": "Not viable. The clouds are a low stratus bank on the horizon (0.5-5 deg) the same lilac as the twilight behind it; no cue separates it from the glow (evidence: sky_qwantani_dusk_2_puresky_clouds_rejected.png). Use the HDRI itself as the visible sky."
      },
      {
        "id": "qwantani_night_puresky",
        "src": "assets-src/polyhaven/hdri/qwantani_night_puresky_4k.hdr",
        "mood": "night",
        "stars": true,
        "credit": {
          "author": "Greg Zaal (photography), Jarod Guest (processing)",
          "url": "https://polyhaven.com/a/qwantani_night_puresky"
        }
      },
      {
        "id": "kloofendal_48d_partly_cloudy_puresky",
        "src": "assets-src/polyhaven/hdri/kloofendal_48d_partly_cloudy_puresky_4k.hdr",
        "mood": "day",
        "clouds": true,
        "credit": {
          "author": "Greg Zaal (original), Jarod Guest (sky edits)",
          "url": "https://polyhaven.com/a/kloofendal_48d_partly_cloudy_puresky"
        }
      }
    ]
  },
