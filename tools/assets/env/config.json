          "roughness": "assets-src/ambientcg/Ground093C/Ground093C_2K-JPG_Roughness.jpg"
        },
        "sizeM": [
          3,
          3
        ],
        "sizeSource": "estimate: ambientCG publishes no dimensions for Ground093C; set from the scale of the wind-eroded ripples",
        "why": "Chosen over Poly Haven coast_sand_01: Ground093C is the warm cream sand of the palette, while coast_sand_01 is brown and gravelly with debris."
      },
      {
        "id": "sand_wet",
        "source": "Poly Haven damp_beach_sand_02",
        "credit": {
          "author": "Dimitrios Savva",
          "url": "https://polyhaven.com/a/damp_beach_sand_02"
        },
        "maps": {
          "albedo": "assets-src/polyhaven/textures/damp_beach_sand_02/textures/damp_beach_sand_02_diff_2k.jpg",
          "normal": "assets-src/polyhaven/textures/damp_beach_sand_02/textures/damp_beach_sand_02_nor_gl_2k.jpg",
          "arm": "assets-src/polyhaven/textures/damp_beach_sand_02/textures/damp_beach_sand_02_arm_2k.jpg"
        },
        "sizeM": [
          1.87,
          1.87
        ],
        "sizeSource": "Poly Haven API dimensions",
        "calibrate": {
          "meanLinearRGB": [
            0.24,
            0.193,
            0.117
          ]
        },
        "why": "Source albedo is very dark (mean linear 0.11) and reads olive-grey next to sand_dry; it is scaled per channel to sand_dry's mean colour x 0.4 (wet sand is roughly 40-50% as bright as the same sand dry), keeping its variation, so the shoreline blends from dry to wet without a hue jump. Remove `calibrate` in config.json to get the source colours back."
