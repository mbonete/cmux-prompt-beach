    "sets": [
      {
        "id": "sand_dry",
        "source": "ambientCG Ground093C",
        "credit": {
          "author": "ambientCG (Lennart Demes)",
          "url": "https://ambientcg.com/view?id=Ground093C"
        },
        "maps": {
          "albedo": "assets-src/ambientcg/Ground093C/Ground093C_2K-JPG_Color.jpg",
          "normal": "assets-src/ambientcg/Ground093C/Ground093C_2K-JPG_NormalGL.jpg",
