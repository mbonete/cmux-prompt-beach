{
  "name": "cmux-switchboard",
  "version": "0.1.0",
  "private": true,
  "description": "A live local dashboard for the agents running in cmux: who is working, who needs you, who went stale.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "demo": "node server.mjs --demo",
    "dev": "vite",
    "build": "node tools/clean-build.mjs && vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.mjs",
    "assets:fetch": "node tools/assets/fetch.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/three": "0.187.0",
    "meshoptimizer": "1.2.0",
    "sharp": "0.35.5",
    "three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
